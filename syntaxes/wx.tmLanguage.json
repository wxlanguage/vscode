{
	"$schema": "https://json.schemastore.org/tmlanguage.json",
	"name": "WX",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#attributes" },
		{ "include": "#labels" },
		{ "include": "#keywords" },
		{ "include": "#types" },
		{ "include": "#pointers" },
		{ "include": "#numbers" },
		{ "include": "#strings" },
		{ "include": "#chars" },
		{ "include": "#functions" },
		{ "include": "#identifiers" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.documentation.wx",
					"match": "///.*$"
				},
				{
					"name": "comment.line.double-slash.wx",
					"match": "//.*$"
				}
			]
		},
		"attributes": {
			"patterns": [
				{
					"name": "meta.attribute.wx",
					"begin": "#\\[",
					"end": "\\]",
					"patterns": [
						{ "include": "#strings" },
						{ "include": "#numbers" }
					]
				}
			]
		},
		"labels": {
			"patterns": [
				{
					"match": "\\b(loop|block|break|continue)\\s+(:[a-zA-Z_]\\w*)",
					"captures": {
						"1": {
							"name": "keyword.control.wx"
						},
						"2": {
							"name": "entity.name.label.wx"
						}
					}
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "storage.type.wx",
					"match": "\\b(func|struct|trait|impl|enum|type|typeset|memory|local|global|const|mod|package|pub|mut|use|where)\\b"
				},
				{
					"name": "keyword.control.wx",
					"match": "\\b(if|else|loop|block|break|continue|return|for|match)\\b"
				},
				{
					"name": "keyword.other.wx",
					"match": "\\b(import|export|as|self|Self|super)\\b"
				},
				{
					"name": "constant.language.wx",
					"match": "\\b(True|False)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "entity.name.type.primitive.wx",
					"match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|funcref|Bool|Char)\\b"
				}
			]
		},
		"pointers": {
			"patterns": [
				{
					"name": "storage.modifier.wx",
					"match": "(?<=::)[*&]|\\.[*&]"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.wx",
					"match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d[\\d_]*)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d[\\d_]*\\b"
				},
				{
					"name": "constant.numeric.binary.wx",
					"match": "\\b0b[01][01_]*\\b"
				},
				{
					"name": "constant.numeric.hex.wx",
					"match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
				},
				{
					"name": "constant.numeric.integer.wx",
					"match": "\\b\\d[\\d_]*\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.wx",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.wx",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"chars": {
			"patterns": [
				{
					"name": "string.quoted.single.wx",
					"match": "'(?:\\\\.|[^'\\\\])*'"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.wx",
					"match": "\\b([a-zA-Z_]\\w*)\\s*(?=(::<[^()]*>)?\\()"
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"name": "variable.other.wx",
					"match": "\\b[a-zA-Z_]\\w*\\b"
				}
			]
		}
	},
	"scopeName": "source.wx"
}
